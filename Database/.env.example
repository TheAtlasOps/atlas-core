# =============================================================================
# VARIABLES DE ENTORNO PARA CONEXIÓN A BASE DE DATOS - ATLAS BACKEND (FASTAPI)
# AUTOR: Alexander Sáez (Gestión de Base de Datos)
# =============================================================================

# Cadena de conexión para PostgreSQL (Neon.tech / Supabase / RDS)
# Formato: postgresql+asyncpg://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<DB_NAME>?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_sample_password@ep-atlas-sample.us-east-2.aws.neon.tech/atlas_fsm?sslmode=require

# Conexión sincrónica alternativa (para Alembic / Migraciones)
DATABASE_SYNC_URL=postgresql://neondb_owner:npg_sample_password@ep-atlas-sample.us-east-2.aws.neon.tech/atlas_fsm?sslmode=require

# Parámetros del Pool de Conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Clave secreta para tokens de Magic Links
MAGIC_LINK_SECRET_KEY=atlas_super_secret_jwt_key_change_in_production
MAGIC_LINK_EXPIRE_HOURS=48
