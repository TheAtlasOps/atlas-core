# =============================================================================
# VARIABLES DE ENTORNO - ATLAS BACKEND (FASTAPI)
# =============================================================================

# Configuración General del Proyecto
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Atlas - Field Service Management API"
API_V1_STR=/api/v1

# Conexión a Base de Datos PostgreSQL (Neon.tech / Supabase / AWS RDS)
# Asíncrona (FastAPI / asyncpg):
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_sample_password@ep-atlas-sample.us-east-2.aws.neon.tech/atlas_fsm?sslmode=require
# Sincrónica (Alembic / Migraciones DDL):
DATABASE_SYNC_URL=postgresql://neondb_owner:npg_sample_password@ep-atlas-sample.us-east-2.aws.neon.tech/atlas_fsm?sslmode=require

# Parámetros del Connection Pool (Neon Free Tier Optimization)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Seguridad: Autenticación Interna (JWT & RBAC - RNF-SEG-02)
JWT_SECRET_KEY=atlas_jwt_secret_key_minimum_256_bits_length_for_hs256_change_in_prod_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seguridad: Portal Clientes Magic Links (RNF-SEG-03)
MAGIC_LINK_SECRET_KEY=atlas_magic_link_token_secret_key_change_in_production_987654
MAGIC_LINK_EXPIRE_HOURS=48
FRONTEND_PORTAL_URL=http://localhost:5173/status

# CORS - Orígenes permitidos (separados por coma o formato JSON)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://atlas-fsm.vercel.app

# Proveedor de Correos Transaccionales (Resend)
RESEND_API_KEY=re_sample_api_key_here
EMAILS_FROM_EMAIL=notificaciones@atlasops.cl

# Almacenamiento Cloud para Evidencias Multimedia (Google Cloud Storage)
GCS_BUCKET_NAME=atlas-evidences
GCS_CREDENTIALS_JSON=
