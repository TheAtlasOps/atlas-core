{
  "expo": {
    "name": "atlas-app-tecnico",
    "slug": "atlas-app-tecnico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cl.atlasfsm.tecnico",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Atlas Técnico necesita acceder a tu ubicación para notificar al cliente y al centro de despacho mientras te desplazas en ruta.",
          "locationWhenInUsePermission": "Atlas Técnico requiere tu ubicación para verificar el arribo y registro de intervenciones en terreno.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Atlas Técnico necesita acceder a tus fotos para adjuntar evidencia de las visitas.",
          "cameraPermission": "Atlas Técnico necesita usar la cámara para tomar fotos de evidencia en terreno."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
