{
  "expo": {
    "name": "atlas-app-tecnico",
    "slug": "atlas-app-tecnico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Atlas Técnico necesita acceder a tus fotos para adjuntar evidencia de las visitas.",
          "cameraPermission": "Atlas Técnico necesita usar la cámara para tomar fotos de evidencia en terreno."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
